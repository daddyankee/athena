{
  "manifest_version": 3,
  "name": "Athena",
  "version": "1.0",
  "description": "Athena AI chat in a side panel",
  "permissions": ["sidePanel"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Athena"
  }
}
